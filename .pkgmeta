# Configuration for the BigWigs packager (used by the GitHub Actions workflow).
# https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File

# The addon files live at the repo root; wrap them in a folder named
# "Flatulence" inside the release zip so it installs to
# Interface\AddOns\Flatulence\.
package-as: Flatulence

# Don't ship repo/meta files inside the addon zip.
ignore:
  - README.md
  - CHANGELOG.md
  - LICENSE
  - .gitignore
  - .pkgmeta
  - .github
  - Sounds/README.txt

# No external libraries to pull in.
externals: {}

# Turn the "## Notes" and changelog handling on with sensible defaults.
enable-nolib-creation: no
